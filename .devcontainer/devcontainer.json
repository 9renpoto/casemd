{
	"name": "Go CLI Environment",
	"image": "mcr.microsoft.com/devcontainers/go:2-1.26-bookworm@sha256:de99286e746c99e359edddaf0c47cbfbed34f4d6a3cd6310c99c87fa27c3c341",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": true,
			"installDockerBuildx": true,
			"version": "latest"
		},
		"ghcr.io/devcontainers-extra/features/lefthook-asdf:1": {},
		"ghcr.io/michidk/devcontainers-features/typos:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"ms-azuretools.vscode-docker",
				"openai.chatgpt"
			]
		}
	},
	"forwardPorts": [
		3000
	],
	"postCreateCommand": "lefthook install",
	"postStartCommand": "bash -lc 'pkill -f \"casemd serve\" || true; CASEMD_WEB_ADDR=0.0.0.0:3000 nohup go run ./cmd/casemd serve > /tmp/casemd-web.log 2>&1 &'",
	"remoteUser": "vscode"
}
